<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Emergency SOS"
        app:titleTextColor="@color/primary"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="@color/primary"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvWarning"
        style="@style/BodyStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="32dp"
        android:gravity="center"
        android:text="Press and hold the button below to send an emergency alert to the front desk and security."
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <!-- SOS Button Container (for pulsing effect) -->
    <FrameLayout
        android:id="@+id/sosButtonContainer"
        android:layout_width="260dp"
        android:layout_height="260dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvWarning"
        app:layout_constraintVertical_bias="0.4">

        <View
            android:id="@+id/pulseView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_sos_circle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSosBig"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:backgroundTint="@color/sos_red"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            android:text="SOS"
            android:textColor="@color/white"
            android:textSize="36sp"
            android:textStyle="bold"
            app:cornerRadius="90dp"
            app:elevation="12dp" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvCountdown"
        style="@style/HeadingStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Sending alert in 5..."
        android:textColor="@color/sos_red"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sosButtonContainer" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelSos"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="TAP TO CANCEL"
        android:textColor="@color/text_secondary"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvCountdown" />

</androidx.constraintlayout.widget.ConstraintLayout>