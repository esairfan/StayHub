<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Remote Video (Full Screen) -->
    <FrameLayout
        android:id="@+id/remoteVideoContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/primary_dark" />

    <!-- Local Video (Overlay) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/localVideoCard"
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:layout_margin="24dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp"
        app:strokeWidth="2dp"
        app:strokeColor="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <FrameLayout
            android:id="@+id/localVideoContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/text_secondary" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Caller Info Overlay -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            style="@style/HeadingStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Front Desk"
            android:textColor="@color/white"
            android:textSize="24sp" />
        <TextView
            style="@style/BodyStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="02:45"
            android:textColor="#CCFFFFFF" />
    </LinearLayout>

    <!-- Controls Overlay -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="32dp"
        android:background="@drawable/bg_gradient_bottom"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnFlipCamera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            app:fabSize="normal"
            app:srcCompat="@android:drawable/ic_menu_rotate"
            app:backgroundTint="#40FFFFFF"
            app:tint="@color/white"
            android:contentDescription="Flip Camera" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnToggleVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            app:fabSize="normal"
            app:srcCompat="@android:drawable/ic_menu_camera"
            app:backgroundTint="#40FFFFFF"
            app:tint="@color/white"
            android:contentDescription="Toggle Video" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnEndVideoCall"
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:fabCustomSize="72dp"
            app:srcCompat="@android:drawable/ic_menu_close_clear_cancel"
            app:backgroundTint="@color/sos_red"
            app:tint="@color/white"
            android:contentDescription="End Call" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnToggleMic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            app:fabSize="normal"
            app:srcCompat="@android:drawable/ic_lock_silent_mode_off"
            app:backgroundTint="#40FFFFFF"
            app:tint="@color/white"
            android:contentDescription="Mute" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>