<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="@color/background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Identity Verification"
        app:navigationIcon="@android:drawable/ic_menu_revert" />

    <TextView
        style="@style/BodyStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Please upload a photo of your ID (Passport or National ID) to complete your check-in."
        android:gravity="center"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="32dp" />

    <com.google.android.material.card.MaterialCardView
        style="@style/CardViewStyle"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_margin="0dp"
        app:strokeWidth="2dp"
        app:strokeColor="@color/primary_light"
        app:cardElevation="0dp"
        android:layout_marginBottom="32dp">

        <ImageView
            android:id="@+id/ivKycPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_camera"
            android:padding="80dp"
            app:tint="@color/primary_light"
            android:contentDescription="@string/amenity_icon" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnChooseGallery"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Choose from Gallery"
        app:icon="@android:drawable/ic_menu_gallery"
        app:cornerRadius="12dp"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTakePhoto"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Take Photo"
        app:icon="@android:drawable/ic_menu_camera"
        app:cornerRadius="12dp"
        android:layout_marginBottom="32dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmitKyc"
        style="@style/PrimaryButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Submit Verification"
        android:enabled="false" />

    <ProgressBar
        android:id="@+id/pbUpload"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginTop="16dp" />

</LinearLayout>